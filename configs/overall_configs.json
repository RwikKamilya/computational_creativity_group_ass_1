      "nutty":       { "vanilla": 0.85, "chocolate": 0.90, "caramel": 0.85, "warm_spice": 0.80, "oat": 0.80, "citrus": 0.55, "coffee": 0.80, "fruit": 0.70 },
      "citrus":      { "vanilla": 0.70, "chocolate": 0.60, "caramel": 0.55, "nutty": 0.55, "warm_spice": 0.65, "oat": 0.60, "coffee": 0.50, "fruit": 0.85 },
      "warm_spice":  { "vanilla": 0.80, "chocolate": 0.75, "caramel": 0.80, "nutty": 0.80, "oat": 0.75, "citrus": 0.65, "coffee": 0.70, "fruit": 0.75 },
      "oat":         { "vanilla": 0.85, "chocolate": 0.80, "caramel": 0.75, "nutty": 0.80, "warm_spice": 0.75, "fruit": 0.70 },
