{
  "version": "0.1.0",
  "categories": [
    {
      "id": "cookie",
      "name": "Cookie",
      "required_ingredients": [
        "butter_unsalted",
        "egg_whole"
      ],
      "required_roles": [
        "base",
        "fat",
        "binder",
        "sweetener"
      ],
      "optional_roles": [
        "riser",
        "flavor",
        "salt",
        "inclusion"
      ],
      "ratio_constraints": {
        "base": {
          "min": 0.20,
          "max": 0.60
        },
        "fat": {
          "min": 0.15,
          "max": 0.35
        },
        "sweetener": {
          "min": 0.15,
          "max": 0.35
        },
        "binder": {
          "min": 0.05,
          "max": 0.15
        },
        "riser": {
          "min": 0.003,
          "max": 0.02
        },
        "salt": {
          "min": 0.002,
          "max": 0.01
        }
      },
      "size_constraints": {
        "total_mass_g": {
          "min": 300,
          "max": 1200
        }
      }
    }
  ],
  "roles": {
    "base": "Provides starch/structure",
    "fat": "Tenderizes, binds, carries flavor",
    "binder": "Eggs or substitutes that set structure",
    "sweetener": "Sugar/syrups for sweetness & texture",
    "liquid": "Hydration; dissolves sugar; gluten control",
    "riser": "Leavening",
    "salt": "Balances flavor",
    "flavor": "Aromatics/spices/extracts",
    "inclusion": "Chunks/mix-ins (chips, nuts, oats)"
  },
  "validity": {
    "hard_rules": [
      {
        "id": "creaming_requires_fat",
        "category": "cookie",
        "type": "min_role_count",
        "role": "fat",
        "min": 1
      },
      {
        "id": "creaming_requires_crystalline_sugar",
        "category": "cookie",
        "type": "requires_any_ingredients",
        "ingredients": [
          "sugar_white",
          "sugar_brown"
        ]
      },
      {
        "id": "creaming_fat_must_be_creamable",
        "category": "cookie",
        "type": "requires_any_ingredients",
        "ingredients": [
          "butter_unsalted"
        ]
      },
      {
        "id": "binder_required_for_template",
        "category": "cookie",
        "type": "min_role_count",
        "role": "binder",
        "min": 1
      },
      {
        "id": "must_have_base_flour",
        "category": "cookie",
        "type": "min_role_count",
        "role": "base",
        "min": 1
      },
      {
        "id": "no_dual_risers",
        "category": "cookie",
        "type": "max_role_count",
        "role": "riser",
        "max": 1
      },
      {
        "id": "leavener_caps_per_flour",
        "category": "cookie",
        "type": "max_leavener_equiv_per_cup_flour",
        "baking_powder_tsp_per_cup_flour_max": 1.25,
        "baking_soda_tsp_per_cup_flour_max": 0.60
      },
      {
        "id": "at_least_one_flavor_or_inclusion",
        "category": "cookie",
        "type": "min_role_count_any",
        "roles": [
          "flavor",
          "inclusion"
        ],
        "min": 1
      }
    ],
    "soft_rules": [
      {
        "id": "ratio_sugar_to_flour_target_tastier",
        "category": "cookie",
        "type": "ratio_preference",
        "numerator_role": "sweetener",
        "denominator_role": "base",
        "target_range": [
          0.90,
          1.30
        ],
        "weight": 0.2,
        "rationale": "Sweeter band for cookies; pushes away from bread-like bases."
      },
      {
        "id": "ratio_fat_to_flour_target_tastier",
        "category": "cookie",
        "type": "ratio_preference",
        "numerator_role": "fat",
        "denominator_role": "base",
        "target_range": [
          0.70,
          1.00
        ],
        "weight": 0.2,
        "rationale": "Richer fat band improves flavor delivery and tenderness."
      },
      {
        "id": "prefer_single_leavener_unless_acid_present",
        "category": "cookie",
        "type": "structure_preference",
        "penalty": 0.1,
        "unless_any": [
          "buttermilk",
          "yogurt_plain",
          "sour_cream",
          "vinegar_cider",
          "molasses",
          "cocoa_powder"
        ],
        "rationale": "Avoids puffed, cakey cookies unless there’s a pH reason."
      },
      {
        "id": "avoid_all_white_sugar",
        "category": "cookie",
        "type": "structure_preference",
        "penalty": 0.2,
        "when_all": [
          "sugar_white"
        ],
        "unless_any": [
          "sugar_brown",
          "molasses"
        ],
        "rationale": "White-only sweetness reads flat; encourage some brown sugar."
      },
      {
        "id": "salt_required_min",
        "category": "cookie",
        "type": "threshold_preference",
        "any_of": [
          "salt_fine"
        ],
        "min_grams": 1.0,
        "weight": 0.2,
        "rationale": "Salt is non-negotiable for flavor balance."
      },
      {
        "id": "character_diversity",
        "category": "cookie",
        "type": "diversity_preference",
        "roles_considered": [
          "flavor",
          "inclusion"
        ],
        "ignore_roles": [],
        "target_effective_count_range": [
          3,
          6
        ],
        "weight": 0.4,
        "rationale": "2–5 character elements gives identity without clutter."
      },
      {
        "id": "flavor_base_ratio",
        "category": "cookie",
        "type": "ratio_preference",
        "numerator_role": "flavor",
        "denominator_role": "base",
        "target_range": [
          0.05,
          0.1
        ],
        "weight": 0.4
      },
      {
        "id": "inclusion_base_ratio",
        "category": "cookie",
        "type": "ratio_preference",
        "numerator_role": "inclusion",
        "denominator_role": "base",
        "target_range": [
          0.2,
          0.3
        ],
        "weight": 0.4
      },
      {
        "id": "limit_free_liquid_for_creaming",
        "category": "cookie",
        "type": "ratio_preference",
        "numerator_role": "liquid",
        "denominator_role": "base",
        "target_range": [
          0.00,
          0.20
        ],
        "weight": 0.1
      }
    ]
  }
}




