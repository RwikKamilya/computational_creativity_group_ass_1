{
  "version": "0.1.0",
  "units": {
    "mass": "g",
    "egg_unit_g": 50
  },

  "categories": [
    {
      "id": "cookie",
      "name": "Cookie",
      "required_ingredients": ["butter_unsalted", "egg_whole"],
      "required_roles": ["base", "fat", "binder", "sweetener"],
      "optional_roles": ["riser", "flavour", "salt", "inclusion"],
      "ratio_constraints": {
        "base": { "min": 0.30, "max": 0.60 },
        "fat": { "min": 0.15, "max": 0.35 },
        "sweetener": { "min": 0.15, "max": 0.35 },
        "binder": { "min": 0.05, "max": 0.15 },
        "riser": { "min": 0.003, "max": 0.02 },
        "salt": { "min": 0.002, "max": 0.01 }
      },
      "size_constraints": { "total_mass_g": { "min": 300, "max": 1200 } }
    },
    {
      "id": "cake",
      "name": "Cake",
      "required_roles": ["base", "fat", "binder", "sweetener", "liquid", "riser"],
      "optional_roles": ["flavour", "salt", "inclusion"],
      "ratio_constraints": {
        "base": { "min": 0.25, "max": 0.50 },
        "fat": { "min": 0.12, "max": 0.28 },
        "sweetener": { "min": 0.18, "max": 0.35 },
        "binder": { "min": 0.08, "max": 0.18 },
        "liquid": { "min": 0.12, "max": 0.30 },
        "riser": { "min": 0.005, "max": 0.02 },
        "salt": { "min": 0.002, "max": 0.01 }
      },
      "size_constraints": { "total_mass_g": { "min": 600, "max": 2000 } }
    }
  ],

  "roles": {
    "base": "Provides starch/structure",
    "fat": "Tenderizes, binds, carries flavour",
    "binder": "Eggs or substitutes that set structure",
    "sweetener": "Sugar/syrups for sweetness & texture",
    "liquid": "Hydration; dissolves sugar; gluten control",
    "riser": "Leavening",
    "salt": "Balances flavour",
    "flavour": "Aromatics/spices/extracts",
    "inclusion": "Chunks/mix-ins (chips, nuts, oats)"
  },

  "flavour_palette": {
    "notes": [
      "vanilla", "chocolate", "caramel", "nutty",
      "citrus", "warm_spice", "oat", "coffee", "fruit"
    ],
    "compatibility": {
      "vanilla":     { "chocolate": 0.95, "caramel": 0.90, "nutty": 0.85, "citrus": 0.70, "warm_spice": 0.80, "oat": 0.85, "coffee": 0.80, "fruit": 0.80 },
