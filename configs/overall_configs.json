      { "id": "cookie_must_have_butter_and_egg", "category": "cookie", "type": "requires_all_ingredients", "ingredients": ["butter_unsalted", "egg_whole"] },
      { "id": "no_dual_risers", "type": "max_role_count", "role": "riser", "max": 1 },
      { "id": "at_least_one_flavor", "type": "min_role_count_any", "roles": ["flavor", "inclusion"], "min": 1 }
    ],
    "soft_rules": [
      { "id": "prefer_brown_sugar_with_chocolate", "type": "pair_preference", "if_any": ["cocoa_powder", "chocolate_chips"], "prefer": ["sugar_brown"], "weight": 0.1 },
      { "id": "oat_loves_warm_spice", "type": "tag_preference", "ingredient": "oats_rolled", "note": "warm_spice", "weight": 0.1 }
    ]
